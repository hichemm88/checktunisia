# Variables du frontend. Toute variable préfixée VITE_ est EMBARQUÉE DANS LE
# BUNDLE et donc publiquement lisible : n'y mettre aucun secret.

# URL de l'API backend.
VITE_API_URL=http://localhost:8000/api/v1

# ── CRM de prospection interne (crm.qayed.tn) ────────────────────────────────
# Build séparé (vite.crm.config.ts / Dockerfile.crm), sans effet sur l'app
# principale. VITE_CRM_API_URL : voir src/crm/lib/api.ts — vide en local
# (le proxy /api de vite.crm.config.ts suffit), obligatoire en production
# (services Railway distincts, aucun chemin relatif possible).
VITE_CRM_API_URL=
# Clé PUBLIQUE VAPID des notifications push — même paire que VAPID_PUBLIC_KEY
# côté checktunisia-backend (voir son .env.example). Vide = bouton "Activer
# les notifications" inerte, rien d'autre n'en dépend.
VITE_VAPID_PUBLIC_KEY=

# ── Suivi des erreurs (Sentry) ───────────────────────────────────────────────
# Vide = SDK totalement inerte. Un DSN Sentry est conçu pour être public
# (écriture seule), contrairement à une clé d'API.
# Le filtrage des données personnelles est dans src/lib/sentry.ts et testé
# dans src/lib/sentry.test.ts : ni saisies clavier, ni corps de requête,
# ni query string, ni session replay.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
# Version déployée, pour rattacher une erreur à un déploiement (ex. SHA git).
VITE_SENTRY_RELEASE=
